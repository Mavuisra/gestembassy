# Environnement : development | production
DJANGO_ENV=development

# Obligatoire et fort en production (pas de fallback)
DJANGO_SECRET_KEY=changez-moi-en-production-min-50-caracteres-aleatoires

# En production : False obligatoire
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Déploiement test : https://votre-site.netlify.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Laisser vide → SQLite (local + déploiement test Render)
# Optionnel plus tard : PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/ambadrcor

# URL du front (liens e-mail, etc.)
PUBLIC_APP_URL=http://localhost:5173

# Exposer /api/docs/ hors DEBUG (déconseillé en prod publique)
EXPOSE_API_DOCS=False

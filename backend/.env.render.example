# À coller dans Render → Service → Environment
# Ne pas committer de vraies valeurs secrètes.

DJANGO_ENV=production
DJANGO_DEBUG=False

# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=REMPLACER_PAR_CLE_FORTE

# Remplacer par ton hostname Render réel (sans https://)
DJANGO_ALLOWED_HOSTS=gestembassy.onrender.com

# Front Netlify
CORS_ALLOWED_ORIGINS=https://drcembassyseoul.netlify.app
CSRF_TRUSTED_ORIGINS=https://drcembassyseoul.netlify.app
PUBLIC_APP_URL=https://drcembassyseoul.netlify.app

# Lié automatiquement si Blueprint + Postgres Render
# Sinon coller l’URL Neon / Supabase / Render Postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

EXPOSE_API_DOCS=False
NOTIFICATION_CHANNELS=in_app,email
NOTIFICATIONS_EMAIL_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Ambassade RDC Séoul <noreply@ambadrcor.local>
